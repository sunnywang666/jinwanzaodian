{
  "name": "jinwan-zaodian-demo",
  "private": true,
  "version": "6.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && vite build --base=./",
    "cap:android": "npm run build:app && npx cap sync android",
    "test": "vitest run",
    "preview": "vite preview",
    "sync-assets": "node scripts/sync-assets.mjs",
    "trim-assets": "node scripts/trim-transparent-assets.mjs",
    "compress-assets": "node scripts/compress-assets.mjs",
    "prepare-assets": "npm run sync-assets && npm run trim-assets"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.9"
  }
